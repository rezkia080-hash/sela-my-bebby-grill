/* =========================================================
   SELA — MY BEBBY GRILL
   Romantic Gen Z Website
   Main Stylesheet
========================================================= */


/* =========================================================
   1. RESET
========================================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    min-height: 100vh;
    overflow-x: hidden;

    font-family:
        "Segoe UI",
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        sans-serif;

    color: #ffffff;

    background:
        radial-gradient(
            circle at 20% 20%,
            rgba(192, 132, 252, 0.25),
            transparent 30%
        ),
        radial-gradient(
            circle at 80% 30%,
            rgba(236, 72, 153, 0.18),
            transparent 30%
        ),
        linear-gradient(
            135deg,
            #10001f 0%,
            #24003f 35%,
            #4c1d95 70%,
            #7e22ce 100%
        );

    background-attachment: fixed;
}

body::selection {
    background: #d8b4fe;
    color: #24003f;
}

button {
    font-family: inherit;
}


/* =========================================================
   2. GLOBAL BACKGROUND
========================================================= */

.background {
    position: fixed;
    inset: 0;

    z-index: -10;

    overflow: hidden;

    pointer-events: none;

    background:
        radial-gradient(
            circle at center,
            rgba(168, 85, 247, 0.08),
            transparent 50%
        );
}


/* =========================================================
   3. AURORA
========================================================= */

.aurora {
    position: absolute;

    width: 55vw;
    height: 55vw;

    max-width: 700px;
    max-height: 700px;

    border-radius: 50%;

    filter: blur(80px);

    opacity: 0.35;

    animation:
        auroraFloat 12s ease-in-out infinite alternate;
}

.aurora-one {
    top: -20%;
    left: -10%;

    background:
        radial-gradient(
            circle,
            rgba(168, 85, 247, 0.8),
            transparent 65%
        );
}

.aurora-two {
    right: -15%;
    top: 20%;

    background:
        radial-gradient(
            circle,
            rgba(236, 72, 153, 0.65),
            transparent 65%
        );

    animation-delay: -4s;
}

.aurora-three {
    bottom: -25%;
    left: 20%;

    background:
        radial-gradient(
            circle,
            rgba(129, 140, 248, 0.6),
            transparent 65%
        );

    animation-delay: -8s;
}

@keyframes auroraFloat {

    0% {
        transform:
            translate3d(0, 0, 0)
            scale(1);
    }

    50% {
        transform:
            translate3d(60px, -40px, 0)
            scale(1.15);
    }

    100% {
        transform:
            translate3d(-40px, 60px, 0)
            scale(0.95);
    }
}


/* =========================================================
   4. PARTICLE CONTAINER
========================================================= */

#particles {
    position: fixed;
    inset: 0;

    z-index: 20;

    pointer-events: none;

    overflow: hidden;
}


/* =========================================================
   5. PARTICLES
========================================================= */

.particle {
    position: absolute;

    bottom: -50px;

    user-select: none;

    pointer-events: none;

    animation:
        particleFloat linear forwards;
}

@keyframes particleFloat {

    0% {
        transform:
            translate3d(0, 0, 0)
            rotate(0deg)
            scale(0.7);

        opacity: 0;
    }

    10% {
        opacity: 0.9;
    }

    50% {
        transform:
            translate3d(
                var(--move-x),
                -50vh,
                0
            )
            rotate(180deg)
            scale(1);
    }

    100% {
        transform:
            translate3d(
                calc(var(--move-x) * -0.5),
                -115vh,
                0
            )
            rotate(360deg)
            scale(0.8);

        opacity: 0;
    }
}


/* =========================================================
   6. SCREEN
========================================================= */

.screen {
    min-height: 100svh;

    display: flex;

    align-items: center;
    justify-content: center;

    padding: 30px;

    position: relative;

    text-align: center;
}

.hidden {
    display: none !important;
}


/* =========================================================
   7. OPENING SCREEN
========================================================= */

.opening-content {
    width: min(900px, 100%);

    padding: 35px 20px;

    position: relative;

    animation:
        openingAppear 1.4s ease both;
}

@keyframes openingAppear {

    from {
        opacity: 0;
        transform:
            translateY(30px)
            scale(0.96);
    }

    to {
        opacity: 1;
        transform:
            translateY(0)
            scale(1);
    }
}


.small-label {
    margin-bottom: 22px;

    color: #e9d5ff;

    font-size: 13px;

    letter-spacing: 3px;

    text-transform: uppercase;

    text-shadow:
        0 0 15px rgba(216, 180, 254, 0.8);
}


.opening-content h1 {
    margin-bottom: 25px;

    font-size:
        clamp(42px, 11vw, 90px);

    line-height: 0.98;

    font-weight: 800;

    letter-spacing: -3px;

    text-shadow:
        0 0 15px rgba(255, 255, 255, 0.15),
        0 0 45px rgba(216, 180, 254, 0.5);
}

.opening-content h1 span {
    display: block;

    margin-top: 12px;

    color: #e9d5ff;

    font-weight: 500;

    font-size:
        clamp(30px, 7vw, 65px);

    letter-spacing: -1px;

    background:
        linear-gradient(
            90deg,
            #ffffff,
            #e9d5ff,
            #fbcfe8,
            #ffffff
        );

    background-size: 250% auto;

    -webkit-background-clip: text;
    background-clip: text;

    color: transparent;

    animation:
        gradientText 5s linear infinite;
}

@keyframes gradientText {

    to {
        background-position: 250% center;
    }
}


.opening-description {
    max-width: 580px;

    margin: 0 auto 35px;

    color: #ede9fe;

    font-size:
        clamp(16px, 3vw, 20px);

    line-height: 1.8;

    opacity: 0.9;
}


/* =========================================================
   8. MAIN BUTTON
========================================================= */

.main-button {
    position: relative;

    display: inline-flex;

    align-items: center;
    justify-content: center;

    gap: 10px;

    min-width: 210px;

    padding: 17px 28px;

    border: 1px solid rgba(255, 255, 255, 0.25);

    border-radius: 999px;

    color: #ffffff;

    background:
        linear-gradient(
            135deg,
            rgba(168, 85, 247, 0.9),
            rgba(126, 34, 206, 0.85)
        );

    box-shadow:
        0 10px 35px rgba(88, 28, 135, 0.45),
        inset 0 1px 1px rgba(255, 255, 255, 0.25);

    font-size: 16px;

    font-weight: 700;

    cursor: pointer;

    overflow: hidden;

    transition:
        transform 0.3s ease,
        box-shadow 0.3s ease;
}

.main-button::before {
    content: "";

    position: absolute;

    top: 0;
    left: -100%;

    width: 70%;
    height: 100%;

    background:
        linear-gradient(
            90deg,
            transparent,
            rgba(255, 255, 255, 0.35),
            transparent
        );

    transform: skewX(-20deg);

    transition: left 0.7s ease;
}

.main-button:hover::before {
    left: 140%;
}

.main-button:hover {
    transform:
        translateY(-4px)
        scale(1.03);

    box-shadow:
        0 15px 45px rgba(168, 85, 247, 0.55),
        0 0 30px rgba(216, 180, 254, 0.25);
}

.main-button:active {
    transform: scale(0.96);
}


/* =========================================================
   9. COUNTDOWN
========================================================= */

.countdown-content {
    text-align: center;
}

.countdown-label {
    margin-bottom: 15px;

    color: #e9d5ff;

    letter-spacing: 3px;

    text-transform: uppercase;

    font-size: 13px;
}

#countdownNumber {
    font-size:
        clamp(100px, 30vw, 240px);

    font-weight: 800;

    line-height: 1;

    color: #ffffff;

    text-shadow:
        0 0 20px #c084fc,
        0 0 60px #a855f7,
        0 0 100px rgba(168, 85, 247, 0.6);

    animation:
        countdownPulse 1s ease;
}

@keyframes countdownPulse {

    0% {
        opacity: 0;

        transform:
            scale(0.5);
    }

    60% {
        opacity: 1;

        transform:
            scale(1.15);
    }

    100% {
        transform:
            scale(1);
    }
}

.countdown-content > p:last-child {
    color: #ddd6fe;

    margin-top: 20px;
}


/* =========================================================
   10. MAIN CONTENT
========================================================= */

#mainContent {
    position: relative;

    overflow: hidden;
}


/* =========================================================
   11. INTRO
========================================================= */

.intro-section {
    min-height: 100svh;

    padding:
        100px
        25px;

    display: flex;

    flex-direction: column;

    justify-content: center;

    align-items: center;

    text-align: center;

    position: relative;
}

.section-glow {
    position: absolute;

    width: 300px;
    height: 300px;

    border-radius: 50%;

    background:
        radial-gradient(
            circle,
            rgba(192, 132, 252, 0.25),
            transparent 70%
        );

    filter: blur(20px);

    pointer-events: none;
}

.eyebrow {
    position: relative;

    margin-bottom: 20px;

    color: #e9d5ff;

    font-size: 12px;

    letter-spacing: 4px;

    font-weight: 700;
}

.intro-section h2,
.collage-section h2,
.letter-container h2 {
    position: relative;

    margin-bottom: 25px;

    font-size:
        clamp(36px, 8vw, 70px);

    line-height: 1.05;

    letter-spacing: -2px;

    text-shadow:
        0 0 35px rgba(216, 180, 254, 0.4);
}

.intro-section > p:last-child {
    position: relative;

    max-width: 600px;

    color: #ddd6fe;

    line-height: 1.8;

    font-size: 17px;
}


/* =========================================================
   12. MEMORY SECTIONS
========================================================= */

.memory-section {
    min-height: 100svh;

    padding:
        80px
        20px;

    display: flex;

    justify-content: center;

    align-items: center;
}

.memory-card {
    width: min(650px, 100%);

    position: relative;

    padding: 14px;

    border-radius: 30px;

    border:
        1px solid rgba(255, 255, 255, 0.16);

    background:
        rgba(255, 255, 255, 0.08);

    backdrop-filter: blur(18px);

    -webkit-backdrop-filter: blur(18px);

    box-shadow:
        0 25px 80px rgba(0, 0, 0, 0.35),
        0 0 45px rgba(168, 85, 247, 0.15);

    transition:
        transform 0.5s ease,
        box-shadow 0.5s ease;
}

.memory-card:hover {
    transform:
        translateY(-8px)
        rotate(0.3deg);

    box-shadow:
        0 35px 100px rgba(0, 0, 0, 0.4),
        0 0 60px rgba(168, 85, 247, 0.3);
}

.memory-photo {
    display: block;

    width: 100%;
    height: auto;

    max-height: 78vh;

    object-fit: contain;

    border-radius: 21px;

    background: rgba(0, 0, 0, 0.2);
}

.photo-number {
    position: absolute;

    z-index: 3;

    top: 25px;
    left: 25px;

    width: 50px;
    height: 50px;

    display: flex;

    justify-content: center;
    align-items: center;

    border-radius: 50%;

    color: #ffffff;

    background:
        rgba(30, 10, 50, 0.55);

    border:
        1px solid rgba(255, 255, 255, 0.2);

    backdrop-filter: blur(10px);

    font-size: 13px;

    font-weight: 700;

    box-shadow:
        0 5px 20px rgba(0, 0, 0, 0.3);
}

.memory-caption {
    padding: 18px 10px 8px;

    color: #ede9fe;

    text-align: center;

    font-size: 15px;

    line-height: 1.6;
}

.memory-caption span {
    margin-right: 5px;
}


/* =========================================================
   13. LOVE LETTER
========================================================= */

.letter-section {
    min-height: 100svh;

    padding:
        100px
        20px;

    display: flex;

    justify-content: center;

    align-items: center;
}

.letter-container {
    width: min(800px, 100%);

    padding:
        clamp(30px, 7vw, 70px);

    position: relative;

    text-align: center;

    border-radius: 35px;

    border:
        1px solid rgba(255, 255, 255, 0.18);

    background:
        linear-gradient(
            145deg,
            rgba(255, 255, 255, 0.12),
            rgba(255, 255, 255, 0.04)
        );

    backdrop-filter: blur(25px);

    -webkit-backdrop-filter: blur(25px);

    box-shadow:
        0 30px 100px rgba(0, 0, 0, 0.3),
        inset 0 1px 1px rgba(255, 255, 255, 0.15);
}

.letter-container h2 {
    font-size:
        clamp(35px, 7vw, 65px);
}

.love-letter {
    color: #ede9fe;

    font-size:
        clamp(16px, 2.5vw, 20px);

    line-height: 2;
}

.love-letter p {
    margin-bottom: 25px;
}

.love-letter p:last-child {
    margin-bottom: 0;
}


/* =========================================================
   14. COLLAGE
========================================================= */

.collage-section {
    min-height: 100svh;

    padding:
        100px
        20px;

    text-align: center;
}

.collage {
    width: min(900px, 100%);

    margin: 50px auto 0;

    display: grid;

    grid-template-columns:
        repeat(6, 1fr);

    grid-template-rows:
        repeat(6, 100px);

    gap: 14px;
}

.collage-item {
    overflow: hidden;

    border-radius: 22px;

    border:
        1px solid rgba(255, 255, 255, 0.18);

    background: rgba(255, 255, 255, 0.08);

    box-shadow:
        0 20px 50px rgba(0, 0, 0, 0.3);

    transition:
        transform 0.4s ease,
        box-shadow 0.4s ease;
}

.collage-item:hover {
    transform:
        scale(1.025)
        rotate(0deg);

    box-shadow:
        0 25px 70px rgba(168, 85, 247, 0.35);
}

.collage-item img {
    width: 100%;
    height: 100%;

    object-fit: cover;

    display: block;

    transition:
        transform 0.6s ease;
}

.collage-item:hover img {
    transform: scale(1.05);
}

.collage-one {
    grid-column: 1 / 4;
    grid-row: 1 / 4;

    transform: rotate(-2deg);
}

.collage-two {
    grid-column: 4 / 7;
    grid-row: 1 / 4;

    transform: rotate(2deg);
}

.collage-three {
    grid-column: 1 / 3;
    grid-row: 4 / 7;

    transform: rotate(1deg);
}

.collage-four {
    grid-column: 3 / 5;
    grid-row: 4 / 7;

    transform: rotate(-1deg);
}

.collage-five {
    grid-column: 5 / 7;
    grid-row: 4 / 7;

    transform: rotate(2deg);
}


/* =========================================================
   15. ENDING
========================================================= */

.ending-section {
    min-height: 100svh;

    padding:
        100px 20px;

    display: flex;

    justify-content: center;
    align-items: center;

    text-align: center;

    position: relative;

    background:
        radial-gradient(
            circle at center,
            rgba(168, 85, 247, 0.25),
            transparent 60%
        );
}

.ending-content {
    width: min(800px, 100%);

    position: relative;
}

.ending-small {
    margin-bottom: 25px;

    color: #ddd6fe;

    letter-spacing: 3px;

    font-size: 13px;
}

#endingText {
    margin-bottom: 30px;

    font-size:
        clamp(40px, 9vw, 90px);

    line-height: 1;

    text-shadow:
        0 0 20px rgba(216, 180, 254, 0.6),
        0 0 60px rgba(168, 85, 247, 0.5);

    animation:
        heartbeat 2.2s ease-in-out infinite;
}

@keyframes heartbeat {

    0%,
    100% {
        transform: scale(1);
    }

    15% {
        transform: scale(1.035);
    }

    30% {
        transform: scale(1);
    }

    45% {
        transform: scale(1.025);
    }
}

.ending-message {
    max-width: 500px;

    margin: 0 auto 45px;

    color: #ddd6fe;

    font-size: 17px;

    line-height: 1.8;
}

.final-love {
    display: flex;

    justify-content: center;
    align-items: center;

    gap: 20px;

    margin-bottom: 25px;

    color: #fbcfe8;

    font-size:
        clamp(28px, 7vw, 60px);

    text-shadow:
        0 0 25px rgba(249, 168, 212, 0.65);
}

.final-love strong {
    font-weight: 800;

    letter-spacing: 3px;
}

.final-love span {
    animation:
        heartPulse 1.5s ease-in-out infinite;
}

.final-love span:last-child {
    animation-delay: 0.3s;
}

@keyframes heartPulse {

    0%,
    100% {
        transform: scale(1);
    }

    50% {
        transform: scale(1.25);
    }
}

.ending-content h3 {
    font-size:
        clamp(40px, 9vw, 80px);

    letter-spacing: 8px;

    color: #ffffff;

    text-shadow:
        0 0 35px rgba(216, 180, 254, 0.5);
}

.bebby {
    margin-top: 8px;

    color: #e9d5ff;

    font-size: 14px;

    letter-spacing: 5px;

    font-weight: 700;
}

.replay-button {
    margin-top: 45px;
}


/* =========================================================
   16. MUSIC PLAYER
========================================================= */

.music-player {
    position: fixed;

    z-index: 100;

    right: 18px;
    bottom: 18px;

    width:
        min(310px, calc(100vw - 36px));

    padding: 10px 14px;

    display: flex;

    align-items: center;

    gap: 12px;

    border-radius: 999px;

    border:
        1px solid rgba(255, 255, 255, 0.2);

    background:
        rgba(28, 8, 45, 0.65);

    backdrop-filter: blur(18px);

    -webkit-backdrop-filter: blur(18px);

    box-shadow:
        0 10px 40px rgba(0, 0, 0, 0.35);

    animation:
        playerAppear 0.7s ease both;
}

@keyframes playerAppear {

    from {
        opacity: 0;

        transform:
            translateY(30px);
    }

    to {
        opacity: 1;

        transform:
            translateY(0);
    }
}

#musicButton {
    width: 42px;
    height: 42px;

    flex-shrink: 0;

    border: 0;

    border-radius: 50%;

    color: #ffffff;

    background:
        linear-gradient(
            135deg,
            #a855f7,
            #7e22ce
        );

    cursor: pointer;

    box-shadow:
        0 0 20px rgba(168, 85, 247, 0.4);

    transition:
        transform 0.25s ease;
}

#musicButton:active {
    transform: scale(0.9);
}

.music-info {
    min-width: 0;

    flex: 1;

    text-align: left;
}

.music-info strong {
    display: block;

    overflow: hidden;

    color: #ffffff;

    font-size: 13px;

    white-space: nowrap;

    text-overflow: ellipsis;
}

.music-info small {
    display: block;

    margin-top: 3px;

    color: #c4b5fd;

    font-size: 11px;
}

.music-icon {
    font-size: 20px;

    animation:
        musicFloat 2s ease-in-out infinite;
}

@keyframes musicFloat {

    0%,
    100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-4px);
    }
}


/* =========================================================
   17. RESPONSIVE — TABLET
========================================================= */

@media (max-width: 700px) {

    .opening-content h1 {
        letter-spacing: -2px;
    }

    .memory-section {
        min-height: auto;

        padding:
            65px 15px;
    }

    .memory-card {
        border-radius: 24px;

        padding: 9px;
    }

    .memory-photo {
        border-radius: 17px;

        max-height: none;
    }

    .photo-number {
        width: 42px;
        height: 42px;

        top: 18px;
        left: 18px;

        font-size: 11px;
    }

    .collage {
        grid-template-columns:
            repeat(2, 1fr);

        grid-template-rows:
            repeat(6, 110px);

        gap: 10px;
    }

    .collage-one {
        grid-column: 1 / 2;
        grid-row: 1 / 3;
    }

    .collage-two {
        grid-column: 2 / 3;
   
